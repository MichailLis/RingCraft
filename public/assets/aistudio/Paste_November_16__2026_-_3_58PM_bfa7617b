 {name:'Kia Rio · 16.5 см',meta:'Ø184 · M6 пазы / 4×Ø4.2',p:{outerD:184,innerD:146,thick:12,doorBCD:176,doorN:3,doorHoleD:6.6,doorRot:90,doorSlots:true,slotAngle:18,ears:true,earMargin:6,doorBolt:'M6',doorRecess:'flush',doorHeadClear:.6,spkBCD:158,spkN:4,spkHoleD:4.2,spkRot:45,spkSlots:false,spkBolt:'custom',spkRecess:'none',material:'fanera',chamfer:true}},
