function fastNoteHTML(kind){
  const bolt=S[kind+'Bolt'];
  if(bolt==='custom')return 'Своё отверстие · диаметр задаётся вручную, цековка недоступна для этого слоя.';
  const B=BOLTS[bolt],fa=fastFor(S,kind);
  const cb=fa.active?` · цековка <b>⌴${fmtN(fa.cbD)}×${fmtN(fa.cbDepth,0)}</b> · пол ${fmtN(S.thick-fa.cbDepth,0)} мм`:' · головка выступает над поверхностью';
  return `<b>${bolt} DIN 912</b> · головка Ø${fmtN(B.dk)}×${fmtN(B.k,0)} · шестигранник ${fmtN(B.hex)} · отв. <b>Ø${fmtN(B.clear)}</b> (ISO 273)${cb}`;
}
function renderItems(items){
  let html='';
  items.forEach(it=>{
    if(it.t==='note'){html+=`<div class="fast-note" id="fn_${it.id}"></div>`;return;}
    const id='c_'+it.key;
    const full=it.full?' full':'';
    if(it.t==='slider'){
      html+=`<div class="ctl${full}" id="w_${it.key}"><div class="ctl-head"><label for="${id}">${it.label}</label>
        <span class="ctl-val"><input type="number" id="${id}_n" min="${it.min}" max="${it.max}" step="${it.step}" inputmode="decimal" aria-label="${it.label}, число"><em>${it.unit}</em></span></div>
        <input type="range" id="${id}" min="${it.min}" max="${it.max}" step="${it.step}"></div>`;
    }else if(it.t==='toggle'){
      html+=`<div class="ctl${full}" id="w_${it.key}"><div class="tgl-row"><label for="${id}">${it.label}</label>
        <span class="tgl"><input type="checkbox" id="${id}"><i></i></span></div></div>`;
    }else if(it.t==='stepper'){
      html+=`<div class="ctl${full}" id="w_${it.key}"><div class="tgl-row"><label>${it.label}</label>
        <span class="stepper"><button type="button" id="${id}_m" aria-label="${it.label}: меньше">−</button><b id="${id}_v"></b><button type="button" id="${id}_p" aria-label="${it.label}: больше">+</button></span></div></div>`;
    }else if(it.t==='select'){
      html+=`<div class="ctl${full}" id="w_${it.key}"><div class="ctl-head"><label for="${id}">${it.label}</label></div>
        <div class="sel-wrap"><select id="${id}">${it.opts.map(o=>`<option value="${o[0]}">${o[1]}</option>`).join('')}</select></div></div>`;
    }else if(it.t==='color'){
      html+=`<div class="ctl${full}" id="w_${it.key}"><div class="tgl-row"><label for="${id}">${it.label}</label>
        <span class="color-row"><code id="${id}_x"></code><input type="color" id="${id}"></span></div></div>`;
    }
  });
  return html;
}
function wireItems(items,isLayer){
  items.forEach(it=>{
    if(it.t==='note')return;
    const id='c_'+it.key,el=$('#'+id);
    if(!el)return;
    if(it.t==='slider'){
      const num=$('#'+id+'_n');
      REG[it.key]={...it,el,num,wrap:$('#w_'+it.key),labelEl:$('#w_'+it.key+' label'),layer:isLayer};
      el.addEventListener('input',()=>{S[it.key]=parseFloat(el.value);userEdit();});
      el.addEventListener('change',()=>sfx.tick());
      num.addEventListener('change',()=>{
        let v=parseFloat(num.value);if(!isFinite(v))v=S[it.key];
        S[it.key]=clamp(v,it.min,it.max);userEdit();sfx.tick();
      });
    }else if(it.t==='toggle'){
      REG[it.key]={...it,el,wrap:$('#w_'+it.key),labelEl:$('#w_'+it.key+' label'),layer:isLayer};
      el.addEventListener('change',()=>{S[it.key]=el.checked;userEdit();sfx.toggle();});
    }else if(it.t==='stepper'){
      REG[it.key]={...it,valEl:$('#'+id+'_v'),wrap:$('#w_'+it.key),labelEl:$('#w_'+it.key+' label'),layer:isLayer};
      $('#'+id+'_m').addEventListener('click',()=>{S[it.key]=clamp(S[it.key]-1,it.min,it.max);userEdit();sfx.tick();});
      $('#'+id+'_p').addEventListener('click',()=>{S[it.key]=clamp(S[it.key]+1,it.min,it.max);userEdit();sfx.tick();});
    }else if(it.t==='select'){
      REG[it.key]={...it,el,wrap:$('#w_'+it.key),layer:isLayer};
      el.addEventListener('change',()=>{
        S[it.key]=el.value;
        if(it.key==='doorBolt'||it.key==='spkBolt'){
          const kind=it.key==='doorBolt'?'door':'spk';
          if(el.value!=='custom')S[kind+'HoleD']=BOLTS[el.value].clear;
        }
        userEdit();sfx.toggle();
      });
    }else if(it.t==='color'){
      REG[it.key]={...it,el,hex:$('#'+id+'_x'),wrap:$('#w_'+it.key),layer:isLayer};
      el.addEventListener('input',()=>{S[it.key]=el.value;userEdit();});
    }
  });
}
