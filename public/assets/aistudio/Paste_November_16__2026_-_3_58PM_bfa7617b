let restored=false;
function sanitize(p){
  const s={...DEFAULTS};
  for(const k in DEFAULTS){
    if(!(k in p))continue;
    const v=p[k];
    if(typeof DEFAULTS[k]==='number'&&typeof v==='number'&&isFinite(v))s[k]=LIMITS[k]?clamp(v,LIMITS[k][0],LIMITS[k][1]):v;
    else if(typeof DEFAULTS[k]==='boolean'&&typeof v==='boolean')s[k]=v;
    else if(typeof DEFAULTS[k]==='string'&&typeof v==='string')s[k]=v;
  }
  s.doorN=Math.round(s.doorN);s.spkN=Math.round(s.spkN);
  if(!MATS[s.material])s.material='mdf';
  if(!['draft','std','high'].includes(s.quality))s.quality='std';
  if(!['light','gray','dark'].includes(s.sceneBg))s.sceneBg='light';
  if(!['3d','2d'].includes(s.view))s.view='3d';
  if(!/^#[0-9a-fA-F]{6}$/.test(s.tint))s.tint='#ffffff';
  ['door','spk'].forEach(k=>{
    if(s[k+'Bolt']!=='custom'&&!BOLTS[s[k+'Bolt']])s[k+'Bolt']='custom';
    if(!['none','flush','deep'].includes(s[k+'Recess']))s[k+'Recess']='none';
    if(s[k+'Bolt']!=='custom')s[k+'HoleD']=BOLTS[s[k+'Bolt']].clear;
  });
  return s;
}
function loadState(){
  try{const raw=localStorage.getItem('ringforge.state');
    if(raw){restored=true;return sanitize(JSON.parse(raw));}
  }catch(e){}
  return {...DEFAULTS};
}
let S=loadState();
let saveT=0;
function scheduleSave(){clearTimeout(saveT);saveT=setTimeout(()=>{try{localStorage.setItem('ringforge.state',JSON.stringify(S));}catch(e){}},400);}

const OPEN_DEF={mat:false,scene:false};
let UI={open:{...OPEN_DEF},layer:'door'};
try{const raw=localStorage.getItem('ringforge.ui');
  if(raw){const p=JSON.parse(raw);
    if(p&&p.open)for(const k in OPEN_DEF)if(typeof p.open[k]==='boolean')UI.open[k]=p.open[k];
    if(p&&(p.layer==='door'||p.layer==='spk'))UI.layer=p.layer;}
}catch(e){}
function saveUI(){try{localStorage.setItem('ringforge.ui',JSON.stringify(UI));}catch(e){}}

/* ================= FASTENERS ================= */
function fastFor(s,kind){
  const bolt=s[kind+'Bolt'],rec=s[kind+'Recess'];
  if(bolt==='custom'||rec==='none')return {active:false,bolt,cbD:0,cbDepth:0};
  const B=BOLTS[bolt];
  return {active:true,bolt,B,cbD:B.dk+s[kind+'HeadClear'],cbDepth:B.k+(rec==='deep'?1:0)};
}
const anyCb=s=>fastFor(s,'door').active||fastFor(s,'spk').active;

/* ================= GEOMETRY ================= */
function outlineRadiusFn(s){
  const R=s.outerD/2, lobes=[];
  if(s.ears){
    const d=s.doorBCD/2, fa=fastFor(s,'door');
    const baseR=(fa.active?fa.cbD:s.doorHoleD)/2;
    if(s.doorSlots){
      const h=s.slotAngle*D2R/2, rl=baseR+s.earMargin;
      const step=2*Math.asin(Math.min(.8*rl/d,1)), n=Math.max(2,Math.ceil(2*h/step));
      for(let i=0;i<s.doorN;i++){const a=s.doorRot*D2R+i*TAU/s.doorN;
        for(let k=0;k<=n;k++)lobes.push([d,a-h+2*h*k/n,rl]);}
    }else{
      const rl=baseR+s.earMargin;
      for(let i=0;i<s.doorN;i++)lobes.push([d,s.doorRot*D2R+i*TAU/s.doorN,rl]);
    }
  }
  return th=>{let r=R;
    for(let i=0;i<lobes.length;i++){const l=lobes[i],del=th-l[1],sn=l[0]*Math.sin(del);
      if(Math.abs(sn)<l[2]){const c=l[0]*Math.cos(del)+Math.sqrt(l[2]*l[2]-sn*sn);if(c>r)r=c;}}
    return r;};
}
function outlinePts(s,n){
  const fn=outlineRadiusFn(s),pts=[];
  for(let i=0;i<n;i++){const a=i*TAU/n,r=fn(a);pts.push([r*Math.cos(a),r*Math.sin(a)]);}
  return pts;
}
function slotPts(d,a,half,w){
  const n=Math.max(10,Math.ceil(half*2/D2R/2.5)),m=9,pts=[];
  for(let t=0;t<=n;t++){const ang=a-half+2*half*t/n;pts.push([(d+w/2)*math_cos(ang),(d+w/2)*math_sin(ang)]);}
  const ae=a+half,ce=[d*math_cos(ae),d*math_sin(ae)],ue=[math_cos(ae),math_sin(ae)],ve=[-ue[1],ue[0]];
  for(let t=1;t<m;t++){const p=Math.PI*t/m;pts.push([ce[0]+w/2*(ue[0]*Math.cos(p)+ve[0]*Math.sin(p)),ce[1]+w/2*(ue[1]*Math.cos(p)+ve[1]*Math.sin(p))]);}
  for(let t=0;t<=n;t++){const ang=a+half-2*half*t/n;pts.push([(d-w/2)*math_cos(ang),(d-w/2)*math_sin(ang)]);}
  const as0=a-half,cs=[d*math_cos(as0),d*math_sin(as0)],us=[math_cos(as0),math_sin(as0)],vs=[-us[1],us[0]];
  for(let t=1;t<m;t++){const p=Math.PI*t/m;pts.push([cs[0]+w/2*(-us[0]*Math.cos(p)-vs[0]*Math.sin(p)),cs[1]+w/2*(-us[1]*Math.cos(p)-vs[1]*Math.sin(p))]);}
  return pts;
}
const math_cos=Math.cos, math_sin=Math.sin;
function holeReps(h){
  const r=h.effR;
  if(h.type==='circle')return [[h.cx,h.cy,r]];
  const out=[],d=h.d,ext=h.half+r/d;
  for(let k=0;k<7;k++){const ang=h.ang-ext+2*ext*k/6;out.push([d*Math.cos(ang),d*Math.sin(ang),r]);}
  return out;
}
function buildLayerHoles(s,kind,rf,ir,cutValid){
  const p=kind, fa=fastFor(s,kind);
  const N=s[p+'N'], d=s[p+'BCD']/2, rot=s[p+'Rot'], slots=s[p+'Slots'];
  const slotAng=(kind==='door'?s.slotAngle:s.spkSlotAngle);
  const holeD=s[p+'HoleD'];
  const cbR=fa.active?fa.cbD/2:0, cbDepth=fa.active?Math.min(fa.cbDepth,s.thick-.5):0;
  const holes=[];
  for(let i=0;i<N;i++){
    const a=rot*D2R+i*TAU/N,cx=d*Math.cos(a),cy=d*Math.sin(a);
    if(slots){
      const h=slotAng*D2R/2,w=holeD,effR=fa.active?fa.cbD/2:w/2;
      const extE=h+effR/d;let ok=cutValid;
      if(ok)for(let k=0;k<=10;k++){const ang=a-extE+2*extE*k/10;
        if(d-effR-.35<ir||rf(ang)<d+effR+.35){ok=false;break;}}
      holes.push({kind,idx:i+1,type:'slot',cx,cy,ang:a,d,half:h,w,span:slotAng,
        pts:slotPts(d,a,h,w),cbR,cbW:fa.active?fa.cbD:0,cbPts:fa.active?slotPts(d,a,h,fa.cbD):null,
        cbDepth,effR,valid:ok,bolt:fa.bolt});
    }else{
      const r=holeD/2,effR=fa.active?fa.cbD/2:r;
      const ok=cutValid&&(d-effR-.35>=ir)&&(rf(a)>=d+effR+.35);
      holes.push({kind,idx:i+1,type:'circle',cx,cy,r,cbR,cbDepth,effR,valid:ok,bolt:fa.bolt});
    }
  }
  return holes;
}
function analyze(s){
  const R=s.outerD/2,ir=s.innerD/2,rf=outlineRadiusFn(s);
  let maxR=R;for(let i=0;i<720;i++){const r=rf(i*TAU/720);if(r>maxR)maxR=r;}
  const cutValid=ir<R-1;
  const fd=fastFor(s,'door'),fs=fastFor(s,'spk');
  const holes=[...buildLayerHoles(s,'door',rf,ir,cutValid),...buildLayerHoles(s,'spk',rf,ir,cutValid)];
  const repsArr=holes.map(holeReps);
  for(let i=0;i<holes.length;i++){
    if(!holes[i].valid)continue;
    for(let j=i+1;j<holes.length;j++){
      if(!holes[j].valid)continue;
      let hit=false;
      for(const ra of repsArr[i]){for(const rb of repsArr[j]){
        if(Math.hypot(ra[0]-rb[0],ra[1]-rb[1])<ra[2]+rb[2]-.05){hit=true;break;}}if(hit)break;}
      if(hit){holes[j].valid=false;holes[j].overlap=true;}
    }
  }
  const checks=[];let nErr=0,nWarn=0;
  const err=t=>{checks.push({lv:'err',t});nErr++;};
  const warn=t=>{checks.push({lv:'warn',t});nWarn++;};
  if(!cutValid)err(`Проходное отверстие Ø${fmtN(s.innerD,0)} перекрывает контур — уменьшите вырез или увеличьте внешний Ø.`);
  const badDoor=holes.filter(h=>h.kind==='door'&&!h.valid&&!h.overlap).length;
  const badSpk=holes.filter(h=>h.kind==='spk'&&!h.valid&&!h.overlap).length;
  const badOvD=holes.filter(h=>h.overlap&&h.kind==='door').length;
  const badOvS=holes.filter(h=>h.overlap&&h.kind==='spk').length;
  if(badDoor)err(`Слой 1 (дверь)${fd.active?' с головкой':''}: вне материала ${badDoor} отв. Увеличьте Ø, уменьшите BCD или включите ушки.`);
  if(badSpk)err(`Слой 2 (динамик)${fs.active?' с головкой':''}: вне материала / в вырезе ${badSpk} отв. Проверьте BCD и вырез.`);
  if(badOvD)err(`Слой 1: ${badOvD} отв. пересекаются со слоем 2 и исключены. Разведите слои по углу или BCD.`);
  if(badOvS)err(`Слой 2: ${badOvS} отв. пересекаются со слоем 1 и исключены. Разведите слои по углу или BCD.`);
