function syncControls(){
  const cb=anyCb(S);
  for(const k in REG){
    const r=REG[k],v=S[k];
    if(r.t==='slider'){
      r.el.value=v;r.el.style.setProperty('--p',((v-r.min)/(r.max-r.min)*100)+'%');
      if(document.activeElement!==r.num)r.num.value=+v.toFixed(2);
      if(r.dep)r.wrap.classList.toggle('dim',!r.dep(S));
      if(k==='doorHoleD'||k==='spkHoleD'){
        const kind=k==='doorHoleD'?'door':'spk';
        r.labelEl.textContent=S[kind+'Bolt']!=='custom'?'Ø отв. · ISO 273':(S[kind+'Slots']?'Ширина паза':'Ø отверстия');
      }
    }else if(r.t==='toggle'){
      r.el.checked=!!v;
      if(r.dep)r.wrap.classList.toggle('dim',!r.dep(S));
      if(k==='chamfer')r.labelEl.textContent=cb?'Фаска 45° · недоступна с цековкой':'Фаска по контуру 45°';
    }
    else if(r.t==='stepper'){
      r.valEl.textContent=v;
      if(k==='doorN')r.labelEl.textContent=S.doorSlots?'Кол-во пазов':'Количество';
      if(k==='spkN')r.labelEl.textContent=S.spkSlots?'Кол-во пазов':'Количество';
    }
    else if(r.t==='select'){r.el.value=v;if(r.dep)r.wrap.classList.toggle('dim',!r.dep(S));}
    else if(r.t==='color'){r.el.value=v;r.hex.textContent=v.toUpperCase();}
  }
  SHARED.forEach(g=>{const el=$('#gs_'+g.id);if(el)el.textContent=SHARED_SUM[g.id](S);});
  $('#lts_door').textContent=`Ø${fmtN(S.doorBCD,0)} · ${layerDesc(S,'door')}`;
  $('#lts_spk').textContent=`Ø${fmtN(S.spkBCD,0)} · ${layerDesc(S,'spk')}`;
  const fn=$('#fn_'+UI.layer);if(fn)fn.innerHTML=fastNoteHTML(UI.layer);
}
