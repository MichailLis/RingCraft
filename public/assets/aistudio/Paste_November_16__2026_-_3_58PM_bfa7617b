function layerItems(p){
  const isDoor=p==='door';
  const angKey=isDoor?'slotAngle':'spkSlotAngle';
  const items=[
    select(p+'Bolt','Болт под шестигранник · DIN 912',BOLT_OPTS,{full:true}),
    note(p),
    slider(p+'BCD','BCD · Ø окружности',90,isDoor?250:240,1,'мм'),
    stepper(p+'N','Количество',2,8),
    slider(p+'HoleD','Ø отверстия',2.5,12,.1,'мм',{dep:s=>s[p+'Bolt']==='custom'}),
    slider(p+'Rot','Поворот группы',0,359,1,'°'),
    toggle(p+'Slots','Пазы вместо отв.'),
    slider(angKey,'Угол паза',6,40,1,'°',{dep:s=>s[p+'Slots']}),
    select(p+'Recess','Цековка под головку',RECESS_OPTS,{dep:s=>s[p+'Bolt']!=='custom'}),
    slider(p+'HeadClear','Зазор головки ⌴',.2,1.5,.1,'мм',{dep:s=>s[p+'Bolt']!=='custom'&&s[p+'Recess']!=='none'})
  ];
  if(isDoor){
    items.push(toggle('ears','Монтажные ушки'));
    items.push(slider('earMargin','Вылет ушка',4,12,.5,'мм',{dep:s=>s.ears}));
  }
  return items;
}
