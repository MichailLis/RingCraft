    }else if(kindStr==='ply'){
      for(let y=0;y<256;y+=9){cx.fillStyle=`rgba(120,75,30,${.1+Math.random()*.12})`;cx.fillRect(0,y,256,2.2);}
      for(let i=0;i<900;i++){cx.fillStyle=`rgba(80,50,20,${.03+Math.random()*.07})`;
        cx.fillRect(Math.random()*256,Math.random()*256,2+Math.random()*5,1);}
    }else if(kindStr==='noise'){
      for(let i=0;i<5200;i++){const v=Math.random()<.5?0:255;
        cx.fillStyle=`rgba(${v},${v},${v},${.025+Math.random()*.04})`;
