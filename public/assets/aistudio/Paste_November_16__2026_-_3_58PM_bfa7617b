let activeChip=null;
function clearActiveChip(){if(activeChip){activeChip.removeAttribute('data-active');activeChip=null;}}
function buildChips(){
  const row=$('#presetRow');row.innerHTML='';
  PRESETS.forEach((p,i)=>{
    const b=document.createElement('button');b.type='button';b.className='chip';
    b.innerHTML=`<span class="chip-name">${p.name}</span><span class="chip-meta">${p.meta}</span>`;
    b.addEventListener('click',()=>{
      tweenTo({...DEFAULTS,...p.p,view:S.view,sound:S.sound,quality:S.quality,sceneBg:S.sceneBg});
      clearActiveChip();b.dataset.active='1';activeChip=b;
      toast(`Пресет применён: ${p.name}`,'ok');sfx.preset();
      if(S.view==='2d')setTimeout(fit2D,340);
    });
    row.appendChild(b);
    if(i===0&&!restored){b.dataset.active='1';activeChip=b;}
  });
  const sv=document.createElement('button');sv.type='button';sv.className='chip-save';sv.id='saveChip';
  sv.innerHTML=`${ico('save',14)} Сохранить вид`;
  sv.addEventListener('click',()=>openSaveForm(row,sv));
  row.appendChild(sv);
  renderSaved(row);
}
function getSaved(){
  try{const a=JSON.parse(localStorage.getItem('ringforge.saved'))||[];
    return Array.isArray(a)?a.filter(x=>x&&typeof x.name==='string'&&x.p&&typeof x.p==='object'):[];
  }catch(e){return [];}
}
function setSaved(a){try{localStorage.setItem('ringforge.saved',JSON.stringify(a));}catch(e){}}
function renderSaved(row){
  row.querySelectorAll('.chip.saved').forEach(n=>n.remove());
  const sv=$('#saveChip');
  getSaved().forEach((p,i)=>{
    const b=document.createElement('button');b.type='button';b.className='chip saved';
    const od=+p.p.outerD||180,th=+p.p.thick||16;
    b.innerHTML=`<span class="chip-name"></span><span class="chip-meta">Ø${fmtN(od,0)} · ${fmtN(th,0)} мм</span><span class="chip-x" title="Удалить пресет">✕</span>`;
    b.querySelector('.chip-name').textContent=p.name;
    b.addEventListener('click',e=>{
      if(e.target.classList.contains('chip-x')){
        const arr=getSaved(),rem=arr.splice(i,1)[0];setSaved(arr);buildChips();sfx.del();
        toast(`Пресет «${rem.name}» удалён`,'warn',{label:'Отменить',fn:()=>{const a2=getSaved();a2.splice(i,0,rem);setSaved(a2);buildChips();}});
        return;
      }
      tweenTo({...sanitize(p.p),view:S.view,sound:S.sound});
      clearActiveChip();b.dataset.active='1';activeChip=b;
      toast(`Пресет применён: ${p.name}`,'ok');sfx.preset();
      if(S.view==='2d')setTimeout(fit2D,340);
    });
    if(sv)row.insertBefore(b,sv);else row.appendChild(b);
  });
}
function openSaveForm(row,sv){
  const form=document.createElement('div');form.className='save-form';
  form.innerHTML=`<input type="text" maxlength="26" autocomplete="off" spellcheck="false" placeholder="Название пресета"><button type="button" class="ok">OK</button><button type="button" aria-label="Отмена">✕</button>`;
  const inp=form.querySelector('input');inp.value=`Мой Ø${Math.round(S.outerD)}`;
  sv.replaceWith(form);
  inp.focus();inp.select();
  const done=ok=>{
    if(ok){
      const name=inp.value.trim()||`Мой Ø${Math.round(S.outerD)}`;
      const arr=getSaved();arr.push({name,p:{...S}});setSaved(arr);
      toast(`Пресет «${name}» сохранён`,'ok');sfx.save();
    }
    buildChips();
  };
  form.querySelector('.ok').addEventListener('click',()=>done(true));
  form.querySelectorAll('button')[1].addEventListener('click',()=>done(false));
  inp.addEventListener('keydown',e=>{if(e.key==='Enter')done(true);if(e.key==='Escape')done(false);});
}

/* ================= TWEEN / RANDOM / RESET ================= */
let tweenRaf=0;
function tweenTo(target,ms=300){
  cancelAnimationFrame(tweenRaf);
  const from={...S},keys=Object.keys(target),instant=['doorN','spkN'];
  keys.forEach(k=>{if(typeof target[k]!=='number'||instant.includes(k))S[k]=target[k];});
  if(REDUCED){keys.forEach(k=>{S[k]=target[k];});refresh();return;}
  const t0=performance.now();
  const step=now=>{
    const t=Math.min(1,(now-t0)/ms),e=1-Math.pow(1-t,3);
    keys.forEach(k=>{if(typeof target[k]==='number'&&!instant.includes(k))S[k]=from[k]+(target[k]-from[k])*e;});
    if(t>=1){keys.forEach(k=>{S[k]=target[k];});refresh();return;}
    refresh();tweenRaf=requestAnimationFrame(step);
  };
  tweenRaf=requestAnimationFrame(step);
}
const pick=a=>a[Math.floor(Math.random()*a.length)];
const rnd=(a,b)=>a+Math.random()*(b-a);
function randomize(){
  for(let tries=0;tries<6;tries++){
    const cls=pick([{cut:116,spkB:126},{cut:145,spkB:157},{cut:183,spkB:196}]);
    const innerD=Math.round(cls.cut+rnd(-3,3));
    const spkBCD=Math.round(cls.spkB+rnd(-2,3));
    const outerD=Math.round(spkBCD+rnd(18,32));
    const doorN=pick([3,3,4,6]);
    const doorBCD=Math.round(outerD+pick([-14,-8,-2,6,12]));
    const dBolt=pick(['M4','M5','M5','M6','M8']);
    const thick=pick([12,15,16,18,20,22]);
    const dRec=pick(['flush','flush','deep','none']);
    const sBolt=pick(['custom','custom','M4','M5']);
    const sRec=sBolt==='custom'?'none':pick(['flush','none']);
    const t={outerD,innerD,spkBCD,doorN,doorBCD,doorHoleD:BOLTS[dBolt].clear,
      doorSlots:Math.random()<.35,ears:(doorBCD/2+BOLTS[dBolt].dk/2+3>outerD/2)||Math.random()<.3,
      doorBolt:dBolt,doorRecess:dRec,doorHeadClear:pick([.4,.5,.6]),
      slotAngle:Math.round(rnd(10,26)),earMargin:pick([5,6,7]),
      spkN:pick([3,4,4,6]),spkHoleD:sBolt==='custom'?pick([3.5,4,4.2,4.5]):BOLTS[sBolt].clear,
      spkRot:pick([0,30,45,90]),spkSlots:Math.random()<.2,spkSlotAngle:Math.round(rnd(10,22)),
      spkBolt:sBolt,spkRecess:sRec,spkHeadClear:.5,
      doorRot:Math.round(rnd(0,359)),thick,
