 {name:'СЧ 13 см · 5.25"',meta:'Ø146 · M4⌴ / 4×Ø3.5',p:{outerD:146,innerD:116,thick:8,doorBCD:136,doorN:3,doorHoleD:4.5,doorRot:90,doorSlots:false,ears:true,earMargin:5,doorBolt:'M4',doorRecess:'flush',doorHeadClear:.4,spkBCD:126,spkN:4,spkHoleD:3.5,spkRot:45,spkSlots:false,spkBolt:'custom',spkRecess:'none',material:'fanera',chamfer:true}},
 {name:'20 см · УАЗ / ГАЗель',meta:'Ø232 · M8⌴ / M5⌴',p:{outerD:232,innerD:183,thick:22,doorBCD:220,doorN:4,doorHoleD:9,doorRot:45,doorSlots:true,slotAngle:16,ears:true,earMargin:7,doorBolt:'M8',doorRecess:'deep',doorHeadClear:.8,spkBCD:197,spkN:4,spkHoleD:5.5,spkRot:45,spkSlots:false,spkBolt:'M5',spkRecess:'flush',spkHeadClear:.5,material:'mdf',chamfer:true}}
