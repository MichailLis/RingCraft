    controls.autoRotate=s.autoRotate&&s.rotSpeed>0&&!REDUCED;
    controls.autoRotateSpeed=s.rotSpeed*1.6;
    if(qKey!==s.quality){
      qKey=s.quality;renderer.setPixelRatio(q.pr);
      key.shadow.mapSize.set(q.shadow,q.shadow);
      if(key.shadow.map){key.shadow.map.dispose();key.shadow.map=null;}
      renderer.shadowMap.needsUpdate=true;resize();
    }
    const mk=s.material+'|'+s.tint;
    let matChanged=false;
    if(mk!==lastMK){lastMK=mk;matChanged=true;}
    const mat=getMat(s);
    const gk=geomKey(s);
    if(gk!==lastGK){
      lastGK=gk;
      disposePart();
      const built=buildPart(s,q,false,mat);
      part=built.group;partMeshes=built.meshes;partLines=built.lines;
      part.scale.setScalar(.1);scene.add(part);
      renderer.shadowMap.needsUpdate=true;
