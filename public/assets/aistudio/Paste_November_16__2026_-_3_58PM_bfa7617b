  renderer.domElement.addEventListener('webglcontextlost',e=>{
    e.preventDefault();lost=true;
    document.dispatchEvent(new CustomEvent('ring:fail3d'));
  });
  renderer.domElement.addEventListener('webglcontextrestored',()=>{lost=false;needsApply=true;renderer.shadowMap.needsUpdate=true;});
  document.addEventListener('ring:state',()=>{needsApply=true;});
  resize();

  function loop(){
    requestAnimationFrame(loop);
    const visible=wrap.clientWidth>1;
    if(needsApply&&visible&&!lost)doApply();
    controls.update();
    if(!lost&&visible)renderer.render(scene,camera);
  }
  loop();

  const api={
    resetCam:()=>{controls.reset();},
    png:()=>{
      doApply();
      const w=wrap.clientWidth,off=w<2;
      if(off){renderer.setSize(1280,960,false);camera.aspect=1280/960;camera.updateProjectionMatrix();}
      renderer.render(scene,camera);
      const url=renderer.domElement.toDataURL('image/png');
      if(off)resize();
      return url;
    },
    exportSTL:()=>{
      const s=API.state(),q=QP[s.quality]||QP.std;
      const built=buildPart(s,q,true,new THREE.MeshBasicMaterial());
      built.group.updateMatrixWorld(true);
      const dv=new STLExporter().parse(built.group,{binary:true});
      built.meshes.forEach(m=>{m.geometry.dispose();m.material.dispose();});
      return dv;
    }
  };
  document.dispatchEvent(new CustomEvent('ring:ready3d',{detail:api}));
}catch(err){
  console.warn('RINGFORGE 3D boot failed:',err);
  document.dispatchEvent(new CustomEvent('ring:fail3d'));
}
})();
</script>
</body>
</html>
